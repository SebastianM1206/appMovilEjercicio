VITE_APP_NAME=movilesFinal

# Firebase (Auth + RTDB + Storage para rutas comprimidas)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true -> habilita UPLOAD_ROUTE a Firebase Storage al cerrar una corrida.
# Para avatares y fotos NO toca este flag: esos van por Cloudinary.
VITE_STORAGE_ENABLED=false

# Cloudinary (unsigned upload preset)
# https://cloudinary.com/documentation/upload_images#unsigned_upload
# Settings > Upload > Add upload preset > Signing Mode: Unsigned
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_AVATAR_FOLDER=stride/avatars
VITE_CLOUDINARY_RUN_PHOTO_FOLDER=stride/run-photos
