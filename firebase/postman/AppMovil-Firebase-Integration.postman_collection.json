{
  "info": {
    "name": "AppMovil Firebase Integration",
    "_postman_id": "f4d9de2c-9b6b-4e05-bd1f-dcb01e7a0ec6",
    "description": "Collection para validar integracion Firebase del proyecto AppMovilEjercicio: Auth (REST), RTDB (rules y datos), y escenarios M6/M7.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}'));",
          "}",
          "if (!pm.collectionVariables.get('photoId')) {",
          "  pm.collectionVariables.set('photoId', pm.variables.replaceIn('{{$guid}}'));",
          "}",
          "if (!pm.collectionVariables.get('periodKey')) {",
          "  pm.collectionVariables.set('periodKey', '2026-22');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "Set runId and photoId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://postman-echo.com/get?runId={{runId}}&photoId={{photoId}}",
              "protocol": "https",
              "host": [
                "postman-echo",
                "com"
              ],
              "path": [
                "get"
              ],
              "query": [
                {
                  "key": "runId",
                  "value": "{{runId}}"
                },
                {
                  "key": "photoId",
                  "value": "{{photoId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Variables listas', function () {",
                  "  pm.expect(pm.collectionVariables.get('runId')).to.be.a('string');",
                  "  pm.expect(pm.collectionVariables.get('photoId')).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Auth User A",
      "item": [
        {
          "name": "Sign up User A (opcional)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{passwordA}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={{firebaseApiKey}}",
              "protocol": "https",
              "host": [
                "identitytoolkit",
                "googleapis",
                "com"
              ],
              "path": [
                "v1",
                "accounts:signUp"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{firebaseApiKey}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('idTokenA', data.idToken);",
                  "  pm.collectionVariables.set('uidA', data.localId);",
                  "}",
                  "pm.test('Sign up A: 200 o EMAIL_EXISTS', function () {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in User A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{passwordA}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}",
              "protocol": "https",
              "host": [
                "identitytoolkit",
                "googleapis",
                "com"
              ],
              "path": [
                "v1",
                "accounts:signInWithPassword"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{firebaseApiKey}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sign in A OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('idTokenA', data.idToken);",
                  "pm.collectionVariables.set('uidA', data.localId);"
                ]
              }
            }
          ]
        }
      ]
    },
