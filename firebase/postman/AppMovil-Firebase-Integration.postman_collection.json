    {
      "name": "03 - RTDB Profile",
      "item": [
        {
          "name": "Create/Update public profile A",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"{{displayNameA}}\",\n  \"avatarUrl\": null,\n  \"country\": \"MX\",\n  \"createdAt\": 1716892800000,\n  \"updatedAt\": 1716892800000\n}"
            },
            "url": {
              "raw": "{{databaseUrl}}/users/{{uidA}}/public.json?auth={{idTokenA}}",
              "host": [
                "{{databaseUrl}}"
              ],
              "path": [
                "users",
                "{{uidA}}",
                "public.json"
              ],
              "query": [
                {
                  "key": "auth",
                  "value": "{{idTokenA}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);"
                ]
              }
            }
          ]
        },
        {
          "name": "A cannot write B profile (DENIED)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Hack\",\n  \"avatarUrl\": null,\n  \"country\": \"MX\",\n  \"createdAt\": 1716892800000,\n  \"updatedAt\": 1716892800000\n}"
            },
            "url": {
              "raw": "{{databaseUrl}}/users/{{uidB}}/public.json?auth={{idTokenA}}",
              "host": [
                "{{databaseUrl}}"
              ],
              "path": [
                "users",
                "{{uidB}}",
                "public.json"
              ],
              "query": [
                {
                  "key": "auth",
                  "value": "{{idTokenA}}"
                }
              ]
            }
          }
        }
      ]
    },
